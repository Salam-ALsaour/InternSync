digraph ERD3 {
  graph [rankdir=LR, fontname="Liberation Sans", nodesep=0.25, ranksep=0.55, pad=0.2, bgcolor="white", splines=spline];
  node [shape=plain, fontname="Liberation Sans", fontsize=10];
  edge [color="#44546A", arrowsize=0.9, penwidth=1.0, dir=both, fontname="Liberation Sans", fontsize=9, fontcolor="#333333"];
  placements [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>placements</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK, UQ</B></FONT></TD><TD ALIGN="LEFT">application_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">student_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">cycle_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">vacancy_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">company_supervisor_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">academic_supervisor_id</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">confirmed_by, confirmed_at</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">cancel_reason</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">(student_id, cycle_id) not cancelled</TD></TR></TABLE>>];
  report_slots [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>report_slots</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">placement_id</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">kind, week_no</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">due_at</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">is_late, is_missing</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">accepted_at, closed_at</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">closed_by</TD></TR></TABLE>>];
  report_versions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>report_versions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">slot_id</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">version_no</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">tasks, learning, challenges, plan</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">summary, body_text</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">submitted_at (null = draft)</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">is_late</TD></TR></TABLE>>];
  report_attachments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>report_attachments</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">version_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">file_id</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">role</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">position</TD></TR></TABLE>>];
  report_reviews [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>report_reviews</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">version_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">reviewer_id</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">decision</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">comment</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">created_at</TD></TR></TABLE>>];
  report_comments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>report_comments</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">slot_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">author_id</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">body</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">created_at</TD></TR></TABLE>>];
  report_passages [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>report_passages</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">version_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">university_id</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">idx, char_start, char_end</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT"><FONT COLOR="#C55A11">embedding (vector)</FONT></TD></TR></TABLE>>];
  similarity_checks [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>similarity_checks</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK, UQ</B></FONT></TD><TD ALIGN="LEFT">version_id</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">max_score, is_flagged, threshold</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">model_version</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">decision, decision_comment</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">decided_by</TD></TR></TABLE>>];
  similarity_matches [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>similarity_matches</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">check_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">source_version_id</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">score</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">passages</TD></TR></TABLE>>];
  attendance_weeks [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>attendance_weeks</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">placement_id</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">week_no</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">scheduled_days, attended_days</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">note</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">recorded_by</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">unlocked_until, unlock_reason</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">(placement_id, week_no)</TD></TR></TABLE>>];
  evaluations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>evaluations</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">placement_id</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">type</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">overall_comment, mean_score</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">submitted_by, submitted_at</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">reopen_count, reopen_reason</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">(placement_id, type)</TD></TR></TABLE>>];
  evaluation_scores [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>evaluation_scores</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>evaluation_id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>criterion_id</U></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">score</TD></TR></TABLE>>];
  company_evaluations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>company_evaluations</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>placement_id</U></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">four ratings</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">would_recommend</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">comment</TD></TR></TABLE>>];
  outcome_surveys [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>outcome_surveys</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>placement_id</U></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">job_offer</TD></TR></TABLE>>];
  grades [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>grades</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK, UQ</B></FONT></TD><TD ALIGN="LEFT">placement_id</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">total</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">submitted_by, approved_by</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">return_comment, reopen_reason</TD></TR></TABLE>>];
  grade_component_scores [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>grade_component_scores</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>grade_id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>component_id</U></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">score</TD></TR></TABLE>>];
  certificates [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>certificates</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">placement_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">code</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">file_id</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">issued_by, revoked_by</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">revoke_reason</TD></TR></TABLE>>];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F" BGCOLOR="#F2F2F2"><TR><TD COLSPAN="2" BGCOLOR="#7F7F7F" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#7F7F7F"><I>see other part</I></FONT></TD></TR></TABLE>>];
  rubric_criteria [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F" BGCOLOR="#F2F2F2"><TR><TD COLSPAN="2" BGCOLOR="#7F7F7F" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>rubric_criteria</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#7F7F7F"><I>see other part</I></FONT></TD></TR></TABLE>>];
  grade_components [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F" BGCOLOR="#F2F2F2"><TR><TD COLSPAN="2" BGCOLOR="#7F7F7F" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>grade_components</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#7F7F7F"><I>see other part</I></FONT></TD></TR></TABLE>>];
  files [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F" BGCOLOR="#F2F2F2"><TR><TD COLSPAN="2" BGCOLOR="#7F7F7F" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>files</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#7F7F7F"><I>see other part</I></FONT></TD></TR></TABLE>>];
  universities [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F" BGCOLOR="#F2F2F2"><TR><TD COLSPAN="2" BGCOLOR="#7F7F7F" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>universities</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#7F7F7F"><I>see other part</I></FONT></TD></TR></TABLE>>];
  placements -> report_slots [arrowtail=teetee, arrowhead=crowtee, label=" weekly + final"];
  report_slots -> report_versions [arrowtail=teetee, arrowhead=crowodot];
  report_versions -> report_attachments [arrowtail=teetee, arrowhead=crowodot];
  files -> report_attachments [arrowtail=teetee, arrowhead=crowodot];
  report_versions -> report_reviews [arrowtail=teetee, arrowhead=crowodot];
  report_slots -> report_comments [arrowtail=teetee, arrowhead=crowodot];
  users -> report_comments [arrowtail=teetee, arrowhead=crowodot, label=" writes"];
  report_versions -> report_passages [arrowtail=teetee, arrowhead=crowodot];
  universities -> report_passages [arrowtail=teetee, arrowhead=crowodot, label=" search scope"];
  report_versions -> similarity_checks [arrowtail=teetee, arrowhead=teeodot, label=" checked"];
  similarity_checks -> similarity_matches [arrowtail=teetee, arrowhead=crowodot];
  report_versions -> similarity_matches [arrowtail=teetee, arrowhead=crowodot, label=" source"];
  placements -> attendance_weeks [arrowtail=teetee, arrowhead=crowodot];
  placements -> evaluations [arrowtail=teetee, arrowhead=crowodot, label=" periodic, final"];
  evaluations -> evaluation_scores [arrowtail=teetee, arrowhead=crowtee];
  rubric_criteria -> evaluation_scores [arrowtail=teetee, arrowhead=crowodot];
  placements -> grades [arrowtail=teetee, arrowhead=teetee];
  grades -> grade_component_scores [arrowtail=teetee, arrowhead=crowtee];
  grade_components -> grade_component_scores [arrowtail=teetee, arrowhead=crowodot];
  placements -> certificates [arrowtail=teetee, arrowhead=crowodot, label=" ≤ 1 valid"];
  files -> certificates [arrowtail=teetee, arrowhead=teeodot];
  placements -> company_evaluations [arrowtail=teetee, arrowhead=teeodot];
  placements -> outcome_surveys [arrowtail=teetee, arrowhead=teeodot];
  { rank=same; rubric_criteria; grade_components; }
}