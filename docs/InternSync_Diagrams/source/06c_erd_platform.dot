digraph ERD3 {
  graph [rankdir=LR, fontname="Liberation Sans", nodesep=0.25, ranksep=0.55, pad=0.2, bgcolor="white", splines=spline];
  node [shape=plain, fontname="Liberation Sans", fontsize=10];
  edge [color="#44546A", arrowsize=0.9, penwidth=1.0, dir=both, fontname="Liberation Sans", fontsize=9, fontcolor="#333333"];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">email</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">password_hash</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">role</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">name_en, name_ar</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">language</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">company_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">staff_id</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">department</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">is_active, activated_at</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">failed_logins, locked_until</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">consent_at, last_login_at</TD></TR></TABLE>>];
  account_tokens [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>account_tokens</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">purpose</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">token_hash</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">expires_at, used_at, revoked_at</TD></TR></TABLE>>];
  user_sessions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>user_sessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id (sid)</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">created_at, last_seen_at, expires_at</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">revoked_at, revoke_reason</TD></TR></TABLE>>];
  push_subscriptions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>push_subscriptions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">endpoint</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">p256dh, auth</TD></TR></TABLE>>];
  notifications [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>notifications</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">event, params, link</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">idempotency_key</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">read_at</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">email_status, push_status</TD></TR></TABLE>>];
  audit_log [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>audit_log</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">at</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">user_id</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">role, action</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">entity_type, entity_id</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">student_id, cycle_id</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">old_value, new_value</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">reason</TD></TR></TABLE>>];
  files [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>files</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">storage_key</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">original_name, mime_type</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">size_bytes, sha256</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">purpose</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">uploaded_by</TD></TR></TABLE>>];
  import_batches [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>import_batches</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">kind</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">cycle_id</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">total_rows, created_count</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">rejected</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">new_majors</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">uploaded_by</TD></TR></TABLE>>];
  system_settings [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>system_settings</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>key</U></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">value</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">updated_by</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">updated_at</TD></TR></TABLE>>];
  job_runs [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>job_runs</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">job_name</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">started_at, finished_at</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">status, items, error</TD></TR></TABLE>>];
  training_cycles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F" BGCOLOR="#F2F2F2"><TR><TD COLSPAN="2" BGCOLOR="#7F7F7F" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>training_cycles</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#7F7F7F"><I>see other part</I></FONT></TD></TR></TABLE>>];
  enrollments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F" BGCOLOR="#F2F2F2"><TR><TD COLSPAN="2" BGCOLOR="#7F7F7F" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>enrollments</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>cycle_id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>student_id</U></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#7F7F7F"><I>see other part</I></FONT></TD></TR></TABLE>>];
  users -> account_tokens [arrowtail=teetee, arrowhead=crowodot];
  users -> user_sessions [arrowtail=teetee, arrowhead=crowodot];
  users -> push_subscriptions [arrowtail=teetee, arrowhead=crowodot];
  users -> notifications [arrowtail=teetee, arrowhead=crowodot];
  users -> audit_log [arrowtail=teeodot, arrowhead=crowodot, label=" acts"];
  users -> files [arrowtail=teeodot, arrowhead=crowodot, label=" uploads"];
  users -> import_batches [arrowtail=teetee, arrowhead=crowodot];
  users -> system_settings [arrowtail=teeodot, arrowhead=crowodot, label=" updates"];
  training_cycles -> import_batches [arrowtail=teeodot, arrowhead=crowodot];
  import_batches -> enrollments [arrowtail=teeodot, arrowhead=crowodot, label=" creates"];
  { rank=same; job_runs; system_settings; }
}