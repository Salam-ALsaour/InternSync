digraph ERD2 {
  graph [rankdir=LR, fontname="Liberation Sans", nodesep=0.25, ranksep=0.55, pad=0.2, bgcolor="white", splines=spline];
  node [shape=plain, fontname="Liberation Sans", fontsize=10];
  edge [color="#44546A", arrowsize=0.9, penwidth=1.0, dir=both, fontname="Liberation Sans", fontsize=9, fontcolor="#333333"];
  vacancies [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>vacancies</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">company_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">company_supervisor_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">created_by</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">title, city, description</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">training_type, start, end</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">min_gpa, seats</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">application_deadline</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT"><FONT COLOR="#C55A11">embedding (vector)</FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">embedding_model</TD></TR></TABLE>>];
  vacancy_skills [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>vacancy_skills</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>vacancy_id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>skill_id</U></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">kind</TD></TR></TABLE>>];
  vacancy_majors [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>vacancy_majors</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>vacancy_id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>major_id</U></TD></TR></TABLE>>];
  vacancy_universities [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>vacancy_universities</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>vacancy_id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>university_id</U></TD></TR></TABLE>>];
  applications [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>applications</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">vacancy_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">student_id</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">withdraw_reason</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">fit_score, match_mode, model_version</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">decided_by</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">(vacancy_id, student_id)</TD></TR></TABLE>>];
  placements [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>placements</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK, UQ</B></FONT></TD><TD ALIGN="LEFT">application_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">student_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">cycle_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">vacancy_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">company_supervisor_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>FK</B></FONT></TD><TD ALIGN="LEFT">academic_supervisor_id</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">confirmed_by, confirmed_at</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">cancel_reason</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>UQ</B></FONT></TD><TD ALIGN="LEFT">(student_id, cycle_id) not cancelled</TD></TR></TABLE>>];
  match_scores [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1F3864" BGCOLOR="#F5F8FC"><TR><TD COLSPAN="2" BGCOLOR="#1F3864" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>match_scores</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>student_id</U></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>vacancy_id</U></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">fit_score</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">semantic, required_ratio, preferred_ratio</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">mode</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">matched / missing skill ids</TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">model_version, computed_at</TD></TR></TABLE>>];
  companies [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F" BGCOLOR="#F2F2F2"><TR><TD COLSPAN="2" BGCOLOR="#7F7F7F" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>companies</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#7F7F7F"><I>see other part</I></FONT></TD></TR></TABLE>>];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F" BGCOLOR="#F2F2F2"><TR><TD COLSPAN="2" BGCOLOR="#7F7F7F" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#7F7F7F"><I>see other part</I></FONT></TD></TR></TABLE>>];
  skills [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F" BGCOLOR="#F2F2F2"><TR><TD COLSPAN="2" BGCOLOR="#7F7F7F" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>skills</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#7F7F7F"><I>see other part</I></FONT></TD></TR></TABLE>>];
  majors [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F" BGCOLOR="#F2F2F2"><TR><TD COLSPAN="2" BGCOLOR="#7F7F7F" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>majors</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#7F7F7F"><I>see other part</I></FONT></TD></TR></TABLE>>];
  universities [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F" BGCOLOR="#F2F2F2"><TR><TD COLSPAN="2" BGCOLOR="#7F7F7F" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>universities</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#7F7F7F"><I>see other part</I></FONT></TD></TR></TABLE>>];
  student_profiles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F" BGCOLOR="#F2F2F2"><TR><TD COLSPAN="2" BGCOLOR="#7F7F7F" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>student_profiles</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>user_id</U></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#7F7F7F"><I>see other part</I></FONT></TD></TR></TABLE>>];
  training_cycles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#7F7F7F" BGCOLOR="#F2F2F2"><TR><TD COLSPAN="2" BGCOLOR="#7F7F7F" ALIGN="CENTER"><FONT COLOR="#FFFFFF" POINT-SIZE="11"><B>training_cycles</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1F3864"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>id</U></TD></TR><TR><TD COLSPAN="2" ALIGN="CENTER"><FONT POINT-SIZE="8" COLOR="#7F7F7F"><I>see other part</I></FONT></TD></TR></TABLE>>];
  companies -> vacancies [arrowtail=teetee, arrowhead=crowodot, label=" offers"];
  users -> vacancies [arrowtail=teetee, arrowhead=crowodot, label=" responsible (CS)"];
  vacancies -> vacancy_skills [arrowtail=teetee, arrowhead=crowodot];
  skills -> vacancy_skills [arrowtail=teetee, arrowhead=crowodot];
  vacancies -> vacancy_majors [arrowtail=teetee, arrowhead=crowtee];
  majors -> vacancy_majors [arrowtail=teetee, arrowhead=crowodot];
  vacancies -> vacancy_universities [arrowtail=teetee, arrowhead=crowodot, label=" targets (none = all)"];
  universities -> vacancy_universities [arrowtail=teetee, arrowhead=crowodot];
  vacancies -> applications [arrowtail=teetee, arrowhead=crowodot];
  student_profiles -> applications [arrowtail=teetee, arrowhead=crowodot, label=" applies"];
  applications -> placements [arrowtail=teetee, arrowhead=teeodot, label=" becomes"];
  training_cycles -> placements [arrowtail=teetee, arrowhead=crowodot, label=" in cycle"];
  users -> placements [arrowtail=teetee, arrowhead=crowodot, label=" supervises (CS, AS)"];
  student_profiles -> match_scores [arrowtail=teetee, arrowhead=crowodot];
  vacancies -> match_scores [arrowtail=teetee, arrowhead=crowodot];

}