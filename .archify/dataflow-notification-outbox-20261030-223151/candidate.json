  "cards": [
    {
      "dot": "emerald",
      "title": "Event path",
      "items": [
        "Services call events.* right after the change, so the notification row commits with it or not at all",
        "notify() writes one notifications row per active recipient; a repeated idempotency key is skipped",
        "The deliver job reads pending rows oldest first, sends email and push, and writes the result back"
      ]
    },
    {
      "dot": "amber",
      "title": "Replay and failure",
      "items": [
        "Replay: rows left pending are selected again on the next one-minute run",
        "Email: email_attempts grows on each SMTP failure; at 5 the row becomes failed",
        "Push: one attempt; sent, failed, or skipped without VAPID keys or a subscription",
        "No DLQ: failed rows stay in notifications and nothing reads them again"
      ]
    },
    {
      "dot": "slate",
      "title": "Not in this system",
      "items": [
        "No broker, topics, partitions or consumer groups; the notifications table is the only queue",
        "One deliver run at a time: a PostgreSQL advisory lock skips a second runner",
        "Ownership: every producer and the processor run inside the one API process"
      ]
    }
  ]
}