 "cards": [
  {
   "dot": "emerald",
   "title": "المسار الناجح",
   "items": [
    "⁧الطالب يرسل؛ وauth(\"st\") وplacement_access ينجحان⁩",
    "⁧service.submit ينقل المسودة إلى مُسلَّم، والـ router يحفظ الخانة وصف التدقيق وصف الـ outbox وفحص تشابه معلّق معاً⁩",
    "⁧مهمة التوصيل ترسل report.submitted للمشرف الأكاديمي بالبريد والإشعار الفوري⁩",
    "⁧المشرف المعيّن يقبل التقرير، ويُبلَّغ الطالب عبر نفس الـ outbox⁩"
   ]
  },
  {
   "dot": "rose",
   "title": "مسارات الاعتماد والرفض",
   "items": [
    "⁧فقط المشرف الأكاديمي للتوزيع يقبل أو يطلب تعديلاً، وطلب التعديل يحتاج تعليقاً (422 COMMENT_REQUIRED)⁩",
    "⁧البوابة: 401 UNAUTHENTICATED / SESSION_EXPIRED، و403 CONSENT_REQUIRED وVERIFICATION_REQUIRED وFORBIDDEN⁩",
    "⁧الإرسال: 403 إذا لم يكن التوزيع للطالب، و409 INVALID_TRANSITION وSLOT_CLOSED وCYCLE_CLOSED وNOTHING_TO_SUBMIT وTOO_MANY_ATTACHMENTS، و422 REQUIRED_FIELDS_MISSING وMAIN_DOCUMENT_REQUIRED⁩",
    "⁧الطلب المرفوض يتوقف قبل db.commit()، فلا يُحفظ شيء⁩"
   ]
  },
  {
   "dot": "amber",
   "title": "مسارات الإعادة",
   "items": [
    "⁧التعديل: الانتقال من revision_requested عبر submit مسموح، ويُنشئ نسخة جديدة⁩",
    "⁧التشابه: similarity_retry (كل 5 دقائق) يعيد الفحوص المعلّقة لأكثر من 5 دقائق، والفاشلة التي محاولاتها أقل من 3⁩",
    "⁧البريد: مهمة التوصيل تعيده حتى 5 محاولات؛ والإشعار الفوري يُجرَّب مرة واحدة ويُتجاوز بلا مفاتيح VAPID أو اشتراك⁩"
   ]
  },
  {
   "dot": "violet",
   "title": "الأدلة",
   "items": [
    "سجلات التدقيق تُكتب في نفس معاملة التغيير (الإرسال، القبول، طلب التعديل)",
    "⁧similarity_checks يحفظ الحالة والمحاولات والخطأ والنتيجة وإصدار النموذج، والعلامة استشارية فقط⁩",
    "⁧كل تشغيل لمهمة يسجّل صفاً في job_runs، و/health?deep=true يعرض آخر تشغيل للمجدول والنموذج⁩"
   ]
  },
  {
   "dot": "slate",
   "title": "كيف تُطابق المسارات الطلب",
   "items": [
    "⁧لا توجد في InternSync حلقة AI agent تستدعي أدوات؛ هذه أقرب حلقة حقيقية في الكود⁩",
    "⁧«تشغيل الـ agent» هنا هو معالجة طلبات الـ API، و«تنفيذ الأدوات» هو العمل بالخلفية داخل العملية⁩"
   ]
  }
 ]
}
