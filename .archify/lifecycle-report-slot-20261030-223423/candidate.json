  "cards": [
    {
      "dot": "emerald", "title": "Main progress",
      "items": [
        "Every weekly and final slot is created as draft when the placement is confirmed",
        "Submit moves draft or revision_requested to submitted; the first late submission marks the slot late",
        "Only the placement's academic supervisor can accept, which sets accepted_at"
      ]
    },
    {
      "dot": "amber", "title": "Waiting and interruptions",
      "items": [
        "Submitted waits on the supervisor; revision_requested waits on the student, with no limit on rounds",
        "Missing is a flag on a never-submitted draft past its due time; slot.status stays draft",
        "Reminders go out before the due time and escalations to the coordinator after it; neither changes the status",
        "Any other action is refused with 409 INVALID_TRANSITION or SLOT_CLOSED"
      ]
    },
    {
      "dot": "rose", "title": "Endings",
      "items": [
        "Accepted and Closed missing have no outgoing transitions",
        "Close missing works on a draft with no submitted version once the due time has passed, and sets the flag if the job has not yet",
        "Frozen is not a stored status: while the placement is not active or the cycle is closed, every change is refused",
        "A cancelled placement never returns to active; grade reopen and cycle reopen restore the slot's previous status"
      ]
    }
  ]
