# Copy to deploy/.env (never committed) and fill in. Secrets:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DOMAIN=internsync.tech
POSTGRES_PASSWORD=
JWT_SECRET=

# 1 = with the embedding model (AI matching); 0 = smaller image, basic matching only
WITH_AI=1

# Web push (optional): python -m app.cli vapid-keys inside the api container prints a pair
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@internsync.tech
